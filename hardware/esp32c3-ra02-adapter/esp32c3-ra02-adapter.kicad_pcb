	(title_block
		(title "ESP32-C3 SuperMini to SX1278 Ra-02 breakout adapter")
		(rev "${GIT_DESCRIBE}")
		(comment 1 "Carrier joining an ESP32-C3 SuperMini to an SX1278 Ra-02 433MHz breakout (2x4 header) via a 2x4 socket; all tracks on the back, GND pour on the front")
