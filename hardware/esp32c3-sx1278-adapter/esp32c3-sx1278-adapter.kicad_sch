	(text "ESP32-C3 SuperMini (J1 left row, J2 right row) driving an SX1278 LoRa module (U2).\nSPI: MOSI=GPIO8 SCK=GPIO9 NSS=GPIO0 MISO=GPIO7; RESET=GPIO4 DIO0=GPIO10 DIO1=GPIO6.\nGPIO5 is tied to 3V3: the radio-type strap reads high on this adapter.\nJ3 is the spring antenna wire hole; J4 an optional edge-mount SMA jack (fit one or the other)."
		(exclude_from_sim no)
		(at 60 90 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3228d52e-2d62-5e1a-a014-a01e091a1277")
	)
